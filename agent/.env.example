# Use the same LiveKit project in agent/.env.local and web/.env.local.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret
LIVEKIT_AGENT_DEPLOYMENT=hana-gpt-live

# The OpenAI account needs access to gpt-live-1 and gpt-5.6-luna.
OPENAI_API_KEY=your_openai_key

# Hana. Choose a Cara 4 avatar available to your Anam account.
ANAM_API_KEY=your_anam_key
ANAM_AVATAR_ID=your_hana_avatar_id

# Grumpy Pizza. Set both values explicitly; there is no fallback to Hana.
# You can use the same Anam key if it can access both avatars.
ANAM_PIZZA_API_KEY=your_anam_key
ANAM_PIZZA_AVATAR_ID=your_pizza_avatar_id
